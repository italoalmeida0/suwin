{
  "name": "suwin",
  "version": "1.0.0",
  "description": "Security Undertaking Windows (suwin) - Supervised administrative session coordinator",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "suwin": "./bin/suwin.js",
    "suwinsvc": "./bin/suwinsvc.js"
  },
  "scripts": {
    "start": "node ./bin/suwinsvc.js",
    "suwin": "node ./bin/suwin.js",
    "install-local": "node ./scripts/install.js",
    "uninstall-local": "node ./scripts/uninstall.js",
    "test": "node --test --test-concurrency=1 test/e2e.test.js test/setup.test.js test/log.test.js test/tray.test.js",
    "test:core": "node test/e2e.test.js",
    "package": "node scripts/package.js",
    "check": "node scripts/check.js"
  },
  "keywords": [
    "security",
    "undertaking",
    "windows",
    "suwin",
    "supervisor",
    "session-manager",
    "tray"
  ],
  "author": "Italo Almeida",
  "repository": { "type": "git", "url": "https://github.com/italoalmeida0/suwin.git" },
  "bugs": { "url": "https://github.com/italoalmeida0/suwin/issues" },
  "homepage": "https://github.com/italoalmeida0/suwin#readme",
  "engines": { "node": ">=22" },
  "os": ["win32"],
  "cpu": ["x64", "arm64"],
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.3.5",
    "ws": "^8.18.0"
  }
}
